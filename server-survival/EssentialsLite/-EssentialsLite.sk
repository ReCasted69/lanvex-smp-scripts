#   Lightweight Skript-based EssentialsX parody plugin.
#=====================================================================================
#  CONFIG
#=====================================================================================
options:
    version: "9.0.2" # EssentialsLite Version (Do not change)
    owner_name: "Dimonium_" # Owner of the server
    server_studio: <light blue><bold>Lancasters<reset> <gold><italic>Studios<reset>
    serverip: "play.lancsmp.ru"
    servername: <blue><bold><italic>Lancasters <gold><bold><italic>SMP<reset>
    discord_link: "https://discord.lancsmp.ru"
    prefix: &8[&d<bold><italic>EssentialsLite<reset>&8]<reset>
    info_prefix: &8[<light blue>INFO&8]<reset>
    warn_prefix: &8[<orange>WARN&8]<reset>
    err_prefix: &8[<red>ERROR&8]<reset>
    sparklite_prefix: &8[<yellow><bold><italic>⚡&8]<reset>
    player_join: "<orange><bold>%player% <lime>joined the game!"
    player_leave: "<orange><bold>%player% <red>left the game..."
    afk_disable_trigger: 0.1 #Distance from last location while in afk, before being disabled.
    tpa-cooldown: 30
    tpa-timeout: 30
    ping_warn_treshold: 2000
    ping_kick_treshold: 6000
    tps_warn_treshold: 19
    tps_restart_treshold: 1
    tps_over_treshold: 21
    tps_target: 20
    autoban_treshhold: 2.5 seconds
    ban_time: 1 minute

on load:
    set {lobby.is_lobby} to false
    set {auto.ban} to false
    set {ip.check} to false #DO NOT USE, MAY BAN ALL PLAYERS  
    set {changelog} to 1
    set {sound.play_join/leave_sound} to true # Play a join sound on player join (true/false)
    set {proxy.enabled} to true # Enable proxy transfers. (true/false)
    set {enable.afk.team} to true # Enable AFK Nickname features (true/false)
    set {enable.name.on_start} to true # Logo displayed on server start (true/false)
    set {change_gamerules} to false # Allow for EssentialsLite to change gamerules (true/false)
    set {discord.link} to {@discord_link}
    set {server.name} to "{@servername}"
    set {server.studio} to "{@server_studio}"




















    
#=====================================================================================
# LOADING
#=====================================================================================
    set {esslite::loaded} to now    
    clear {errors::*}
    if plugin "SkBee" is not enabled:
        set {errors::skbee} to true
    send "{@prefix} {@info_prefix} Validating all functions..." to console
    set {_result} to validateSystem()
    if {_result} is "success":
        send "{@prefix} {@info_prefix} All functions were validated" to console
    else if {_result} is not set:
        send "{@prefix} {@err_prefix} Failed to validate functions. Check if file named <grey>'<orange>EL_MainLibrary.sk<grey>' exists." to console
        set {errors::library_failed} to true

    # 3. MINECRAFT TEAMS CONFIGURATION
    if {enable_afk_team} is true:
        set {team.afk.loaded} to true
        execute console command "team add AFK"
        execute console command "team modify AFK color green"
        execute console command "team modify AFK prefix AFK_"
    else:
        set {team.afk.loaded} to false
        execute console command "team clear AFK"

    # 4. CONSOLE COMPLETION LOG
    set {_sec} to difference between now and {esslite::loaded}
    send "{@prefix} {@info_prefix} EssentialsLite has done loading! Done (%{_sec}%)!" to console

    # 5. BROADCASTS & ERROR REPORTING
    if {errors::skbee} is true:
        broadcast "{@prefix} {@err_prefix} <red>Failed to fully load EssentialsLite due to missing dependency: <grey>'<orange>SkBee<grey>'"
        send "{@prefix} {@warn_prefix} Tab completions will be disabled. Loading errors may occur." 

    if {name_on_start} is true:
        if size of {errors::*} > 0:
            broadcast "{@prefix} {@warn_prefix} <yellow>Partially Loaded EssentialsLite %{@version}%"
            broadcast "{@prefix} {@warn_prefix} <gray>Failed checks: <underline><red>Indice of {errors::*} named <grey>'<orange>%indices of {errors::*}%<grey>'"
        else:
            broadcast "{@prefix} {@info_prefix} <lime>Successfully Loaded &d<italic><bold><underline>EL %{@version}%"
        
    broadcast "{@prefix} {@info_prefix} &d<underline>LSUC&UL ©<reset> Copyright Mark" 


on unload:
    send "{@prefix} {@info_prefix} Shutting down EssentialsLite..." to console
    send "{@prefix} {@info_prefix} Removing AFK..." to console
    execute console command "team remove AFK"
    send "{@prefix} {@info_prefix} Done!" to console
    broadcast "{@prefix} {@info_prefix} <red>EssentialsLite has been shut down!"

#=====================================================================================
# ADMIN COMMANDS
#=====================================================================================
# Enable/disable feature
command /feature <text> [<text>]:
    permission: op
    usage: &7▬▬▬▬▬▬▬▬▬ &6Arguments &7▬▬▬▬▬▬▬▬%nl%<light blue>/feature <red>disable <yellow>music <dark grey>-<reset> Disables Music feature%nl% %nl%<light blue>/feature <red>disable <yellow>home <dark grey>-<reset> Disables Home feature%nl% %nl%<light blue>/feature <red>disable <yellow>kms <dark grey>-<reset> Disables KMS feature%nl% %nl%<light blue>/feature <red>disable <yellow>afk <dark grey>-<reset> Disables AFK feature%nl% %nl%<light blue>/feature <lime>enable <yellow>music <dark grey>-<reset> Enables Music feature%nl% %nl%<light blue>/feature <lime>disable <yellow>home <dark grey>-<reset> Enables Home feature%nl% %nl%<light blue>/feature <lime>disable <yellow>kms <dark grey>-<reset> Enables KMS feature%nl% %nl%<light blue>/feature <lime>disable <yellow>afk <dark grey>-<reset> Enables AFK feature%nl%&7▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬
    trigger:
        if arg-2 is not "all":
            if arg-1 is "enable":
                set {_result} to featureToggle(arg-2, true, "once")
                if {_result} is "success":
                    send "{@prefix} {@info_prefix} <lime>Enabled feature <grey>'<orange>%arg-2%<grey>'"
                else if {_result} is "error_1":
                    send "{@prefix} {@err_prefix} <red>No feature named <grey>'<orange>%arg-2%<grey>' <red>was found!"
                else if {_result} is not set:
                    send "{@prefix} {@err_prefix} <red>Failed to execute!"
                else if {_result} is "error_2":
                    send "{@prefix} {@err_prefix} <red>Failed to execute!"
            else if arg-1 is "disable":
                set {_result} to featureToggle(arg-2, false, "once")
                if {_result} is "success":
                    send "{@prefix} {@info_prefix} <light red>Disabled <lime>feature <grey>'<orange>%arg-2%<grey>'"
                else if {_result} is "error_1":
                    send "{@prefix} {@err_prefix} <red>No feature named <grey>'<orange>%arg-2%<grey>' <red>was found!"
                else if {_result} is not set:
                    send "{@prefix} {@err_prefix} <red>Failed to execute!"
                else if {_result} is "error_2":
                    send "{@prefix} {@err_prefix} <red>Failed to execute!"
        else if arg-2 is "all":
            if arg-1 is "enable":
                set {_result} to featureToggle("none", true, "all")
                if {_result} is "success":
                    send "{@prefix} {@info_prefix} <lime>Enabled all features"
                else if {_result} is "error_2":
                    send "{@prefix} {@err_prefix} <red>Failed to execute!"
            else if arg-1 is "disable":
                set {_result} to featureToggle("none", false, "all")
                if {_result} is "success":
                    send "{@prefix} {@info_prefix} <light red>Disabled <lime>all features"
                else if {_result} is "error_2":
                    send "{@prefix} {@err_prefix} <red>Failed to execute!"
        else:
            send "&7▬▬▬▬▬▬▬▬▬ &6Arguments &7▬▬▬▬▬▬▬▬" 
            send "<light blue>/feature <red>disable <yellow>music <dark grey>-<reset> Disables Music feature"
            send ""
            send "<light blue>/feature <red>disable <yellow>home <dark grey>-<reset> Disables Home feature"
            send ""
            send "<light blue>/feature <red>disable <yellow>kms <dark grey>-<reset> Disables KMS feature"
            send ""
            send "<light blue>/feature <red>disable <yellow>afk <dark grey>-<reset> Disables AFK feature"
            send ""
            send "<light blue>/feature <lime>enable <yellow>music <dark grey>-<reset> Enables Music feature"
            send ""
            send "<light blue>/feature <lime>enable <yellow>home <dark grey>-<reset> Enables Home feature"
            send ""
            send "<light blue>/feature <lime>enable <yellow>kms <dark grey>-<reset> Enables KMS feature"
            send ""
            send "<light blue>/feature <lime>enable <yellow>afk <dark grey>-<reset> Enables AFK feature"
            send "&7▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬"
# Ban Player 


# Kill Player
command /kill [<text>]:
    usage: &7▬▬▬▬▬▬▬▬▬ &6Arguments &7▬▬▬▬▬▬▬▬%nl%<light blue>/kill <yellow><player> <dark grey>-<reset> Kill player%nl%&7▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬
    permission: op
    trigger:
        if arg-1 is not set:
            send "&7▬▬▬▬▬▬▬▬▬ &6Arguments &7▬▬▬▬▬▬▬▬" 
            send "<light blue>/kill <yellow><player> <dark grey>-<reset> Kill player"
            send "<light blue>/kill <yellow>@a <dark grey>-<reset> Kill all players"
            send "<light blue>/kill <yellow>mobs <dark grey>-<reset> Kill all mobs"
            send "&7▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬"
            stop
        set {_mode} to "player"
        if arg-1 is "@p" or "all":
            set {_mode} to "all_players"
        else if arg-1 is "@m":
            set {_mode} to "mobs"
        else if arg-1 is "@e":
            set {_mode} to "everything"
        set {_result} to killPlayer(arg-1, {_mode})
        if {_result} is "success":
            if {_mode} is "player":
                send "{@prefix} {@info_prefix}<orange> %arg-1% was killed." to player and console
            if {_mode} is "mobs":
                send "{@prefix} {@info_prefix}<orange> All mobs were killed." to player and console
            if {_mode} is "all_players":
                send "{@prefix} {@info_prefix}<orange> All players were killed." to player and console
        else if {_result} is "error_1":
            send "{@prefix} {@err_prefix} <red>Player named <grey>'<orange>%arg-1%<grey>' was not found or is offline." 
        else if {_result} is "error_afk":
            send "{@prefix} {@err_prefix} <red>Can't kill <grey>'<orange>%arg-1%<grey>', player is AFK"

# Jail
command /setjail:
    permission: op
    trigger:
        set {_result} to setJail(location of player)
        if {_result} is "error_1":
            send "{@prefix} {@err_prefix} <red>Failed to delete jail, jail already set. Delete it first."
        else:
            send "{@prefix} {@info_prefix} <lime>Jail location has been set!" to player and console

command /deljail:
    permission: op
    trigger:
        set {_result} to deleteJail()
        send "{@prefix} {@info_prefix} <orange>Jail location deleted."

command /jail [<player>]:
    permission: op
    trigger:
        if arg-1 is not set:
            send "&7▬▬▬▬▬▬▬▬▬ &6Arguments &7▬▬▬▬▬▬▬▬" 
            send "<light blue>/jail <yellow><player> <dark grey>-<reset> Jail player"
            send "&7▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬"
            stop
        set {_result} to jailPlayer(arg-1)
        if {_result} is "error_1":
            send "{@prefix} {@err_prefix} <red>No jail has been set."
            stop
        if {_result} is "error_2":
            send "{@prefix} {@err_prefix} <red>Player already jailed."
            stop
        send "{@prefix} {@info_prefix} <orange>Player <grey>'<orange>%arg-1%<grey>' <orange>was jailed"

command /unjail [<player>]:
    permission: op
    trigger:
        if arg-1 is not set:
            send "&7▬▬▬▬▬▬▬▬▬ &6Arguments &7▬▬▬▬▬▬▬▬" 
            send "<light blue>/unjail <yellow><player> <dark grey>-<reset> Unjail player"
            send "&7▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬"
            stop
        set {_result} to unjailPlayer(arg-1)
        if {_result} is "error_1":
            send "{@prefix} {@err_prefix} <red>Player is not jailed."
        else:
            send "{@prefix} <lime>You have been unjailed." to arg-1
            broadcast "{@prefix} {@info_prefix} <orange>Player <grey>'<orange>%arg-1%<grey>' <orange>was unjailed"




#Command Invesee
command /invsee [<text>]:
    executable by: players
    permission: op
    usage: &7▬▬▬▬▬▬▬▬▬ &6Arguments &7▬▬▬▬▬▬▬▬%nl%<light blue>/invsee <yellow><player> <dark grey>-<reset> View player's inventory%nl%&7▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬
    trigger:
        set {_target} to arg-1 parsed as player
        if {_target} is not online:
            send "&7▬▬▬▬▬▬▬▬▬ &6Arguments &7▬▬▬▬▬▬▬▬" 
            send "<light blue>/invsee <yellow><player> <dark grey>-<reset> View player's inventory"
            send "&7▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬"
            stop 
        set {_result} to serverInvsee(player, {_target})
        if {_result} is "error_1":
            send "{@prefix} {@err_prefix} <red>You must be a player to use this."
        else if {_result} is "error_2":
            send "{@prefix} {@err_prefix} <red>Player not found."

#Command Spawn
command /setspawn [<text>]:
    permission: op, EssentialsLite.moderator
    trigger:
        if arg-1 is set:
            send "&7▬▬▬▬▬▬▬▬▬ &6Arguments &7▬▬▬▬▬▬▬▬" 
            send "<light blue>/setspawn <dark grey>-<reset> Set the global spawn point"
            send "&7▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬"
            stop
        set {_result} to setSpawn(location of player, player)
        if {_result} is "success":
            send "{@prefix} <lime>Spawn was set at X(%player's x-coordinate%), Y(%player's y-coordinate%), Z(%player's z-coordinate%)"
        else if {_result} is "error_1":
            send "{@prefix} {@err_prefix} <red>Failed to parse function <grey>'<orange>setSpawn(%player%, location of %player%)<grey>' <red>! Cause: <grey>'<orange>Failed to parse player's name<grey>' <orange>"
        else if {_result} is "error_2":
            send "{@prefix} {@err_prefix} <red>Failed to parse function <grey>'<orange>setSpawn(%player%, location of %player%)<grey>' <red>! Cause: <grey>'<orange>Failed to parse player's location<grey>' <orange>"
        else if {_result} is "warning_1":
            send "{@prefix} {@err_prefix} <red>Error in parsing of function <grey>'<orange>setSpawn(%player%, location of %player%)<grey>' <red>! Cause: <grey>'<orange>Failed to change gamerule 'spawn_radius'<grey>' <orange>"
            send "{@prefix} <lime>Spawn was set at X(%player's x-coordinate%), Y(%player's y-coordinate%), Z(%player's z-coordinate%)"

command /delspawn [<text>]:
    permission: op, EssentialsLite.moderator
    trigger:
        if arg-1 is set:
            send "&7▬▬▬▬▬▬▬▬▬ &6Arguments &7▬▬▬▬▬▬▬▬" 
            send "<light blue>/delspawn <dark grey>-<reset> Delete the global spawn point"
            send "&7▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬"
            stop
        set {_result} to deleteSpawn()
        if {_result} is "success":
            send "{@prefix} {@info_prefix} <orange>Spawn location deleted."
        if {_result} is "error_1":
            send "{@prefix} {@warn_prefix} <orange>Spawn location is not set."


command /power <text> [<text>]:
    permission: op
    trigger:
        if arg-1 is "stop":
            if arg-2 is set:
                set {_result} to serverPower("stop", "%{_result}%")
            set {_result} to serverPower("stop", "none")
        if arg-1 is "restart":
            if arg-2 is set:
                set {_result} to serverPower("restart", "%{_result}%")
            set {_result} to serverPower("restart", "none")
        if arg-1 is not set:
            send "&7▬▬▬▬▬▬▬▬▬ &6Arguments &7▬▬▬▬▬▬▬▬" 
            send "<light blue>/power <yellow>stop  <yellow><argument><dark grey>-<reset> Stop server due to <argument>"
            send "<light blue>/power <yellow>restart  <yellow><argument><dark grey>-<reset> Restart server due to <argument>"
            send "&7▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬"


command /ip [<text>] [<offlineplayer>]:
    permission: op
    trigger:
        if arg-1 is "clear":
            if arg-2 is not set:
                send "&7▬▬▬▬▬▬▬▬▬ &6Arguments &7▬▬▬▬▬▬▬▬" 
                send "<light blue>/ip clear <yellow><player> <dark grey>-<reset> Clear player's IP"
                send "&7▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬"
                stop
            clearPlayerIP(arg-2)
        else:
            send "&7▬▬▬▬▬▬▬▬▬ &6Arguments &7▬▬▬▬▬▬▬▬" 
            send "<light blue>/ip clear <yellow><player> <dark grey>-<reset> Clear player's IP security"
            send "&7▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬"

command /ping [<player>] [<integer=4>]:
    trigger:
        if arg-1 is not set:
            set {_p} to player
        else:
            set {_p} to arg-1
        set {_counts} to arg-2
        if arg-2 is less than 1:
            send "<red>Please choose a packet count of 1 or higher." to player
            stop
        send "<gray>▬▬▬▬▬▬▬▬▬▬ <orange><bold>Ping<gray>▬▬▬▬▬▬▬▬▬▬" to player
        set {_calculate_ping} to 0
        send "<lime>Pinging %{_p}% %arg-2% times..." to player
        loop {_counts} times:
            set {_wait} to "%loop-number% seconds" parsed as time span
            wait {_wait}
            send "<red><bold>PACKET %loop-number%" to player
            send "<grey>Ping" to player
            set {_current_ping} to {_p}'s ping
            send "<lime>%{_current_ping}%ms" to player
            set {_raw_pings::%loop-number%} to "%{_current_ping}%ms"
            add {_current_ping} to {_calculate_ping}
        wait 1 second
        send "<lime><bold>Please wait, loading result..." to player  
        set {_calculated_ping} to ({_calculate_ping} / arg-2)    
        wait 3 seconds
        send "<lime><bold>RESULT" to player
        send "<lime>Calculated Latency:  &6%{_calculated_ping}%ms" to player
        set {_raw_string} to join {_raw_pings::*} with ", "
        send "<lime>Raw Latency: &8%{_raw_string}%" to player

command /EssentialsLite/help [<text>]:
    usage: &7▬▬▬▬▬▬▬▬▬ &6Arguments &7▬▬▬▬▬▬▬▬%nl%<light blue>/essentialsLite/help <yellow><number> <dark grey>-<reset> View command list%nl%&7▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬
    trigger:
        set {_page} to arg-1
        if {_page} is not set:
            set {_page} to "1"
        send "" to player
        send "<gray>▬▬▬▬▬▬▬▬▬▬ <cyan><bold>EssentialsLite Help <gray>▬▬▬▬▬▬▬▬▬▬" to player
        if {_page} is "1":
            send "<yellow>Page 1/4 <gray>- <aqua>Admin & Moderation" to player
            send "<gray>▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬" to player
            send "<gray>│ <aqua>/ban⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀<gray>│ <white>Ban a player" to player
            send "<gray>│ <aqua>/unban⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀<gray>│ <white>Unban a player" to player
            send "<gray>│ <aqua>/kick⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀<gray>│ <white>Kick a player" to player
            send "<gray>│ <aqua>/kill⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀<gray>│ <white>Kill a player or self" to player
            send "<gray>│ <aqua>/invsee⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀<gray>│ <white>View player's inventory" to player
            send "<gray>│ <aqua>/setjail⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀<gray>│ <white>Set jail location" to player
            send "<gray>│ <aqua>/deljail⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀<gray>│ <white>Delete jail location" to player
            send "<gray>│ <aqua>/jail⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀<gray>│ <white>Send player to jail" to player
            send "<gray>│ <aqua>/unjail⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀<gray>│ <white>Release jailed player" to player
            send "<gray>│ <aqua>/feature⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀<gray>│ <white>Toggle script features" to player
            send "<gray>▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬" to player
            send "<gray>Use <yellow>/EssentialsLite/help 2 <gray>for player commands." to player
        else if {_page} is "2":
            send "<yellow>Page 2/4 <gray>- <aqua>Player Commands" to player
            send "<gray>▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬" to player
            send "<gray>│ <aqua>/setspawn⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀<gray>│ <white>Set server spawn" to player
            send "<gray>│ <aqua>/delspawn⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀<gray>│ <white>Delete spawn" to player
            send "<gray>│ <aqua>/spawn⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀<gray>│ <white>Teleport to spawn" to player
            send "<gray>│ <aqua>/sethome <name>⠀⠀⠀⠀⠀⠀⠀⠀<gray>│ <white>Set a named home" to player
            send "<gray>│ <aqua>/home <name>⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀<gray>│ <white>Teleport to a home" to player
            send "<gray>│ <aqua>/delhome <name>⠀⠀⠀⠀⠀⠀⠀⠀<gray>│ <white>Delete a named home" to player
            send "<gray>│ <aqua>/afk⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀<gray>│ <white>Toggle AFK mode" to player
            send "<gray>│ <aqua>/kms⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀<gray>│ <white>Kill yourself" to player
            send "<gray>│ <aqua>/music <disc>⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀<gray>│ <white>Play a music disc" to player
            send "<gray>│ <aqua>/music list⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀<gray>│ <white>Show available discs" to player
            send "<gray>│ <aqua>/music stop⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀<gray>│ <white>Stop all music" to player
            send "<gray>│ <aqua>/ping⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀<gray>│ <white>Check your ping" to player
            send "<gray>│ <aqua>/stats server⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀<gray>│ <white>Show server stats" to player
            send "<gray>│ <aqua>/stats player⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀<gray>│ <white>Show your player stats" to player
            send "<gray>▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬" to player
            send "<gray>Use <yellow>/EssentialsLite/help 3 <gray>for transfer commands." to player
        else if {_page} is "3":
            send "<yellow>Page 3/4 <gray>- <aqua>Transfer & Info" to player
            send "<gray>▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬" to player
            send "<gray>│ <aqua>/hub⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀<gray>│ <white>Send yourself to hub" to player
            send "<gray>│ <aqua>/smp⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀<gray>│ <white>Send yourself to SMP" to player
            send "<gray>│ <aqua>/EssentialsLite/status⠀⠀⠀⠀⠀<gray>│ <white>Show feature status" to player
            send "<gray>│ <aqua>/EssentialsLite/version⠀⠀⠀⠀<gray>│ <white>Show plugin version" to player
            send "<gray>│ <aqua>/EssentialsLite/about⠀⠀⠀⠀⠀⠀<gray>│ <white>About EssentialsLite" to player
            send "<gray>▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬" to player
            send "<gray>Use <yellow>/EssentialsLite/help 4 <gray>for feature status." to player
        else if {_page} is "4":
            send "<yellow>Page 4/4 <gray>- <aqua>Feature Status" to player
            send "<gray>▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬" to player
            if {home} is true:
                send "<gray>│ <aqua>Home System⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀<gray>│ <lime>Enabled" to player
            else:
                send "<gray>│ <aqua>Home System⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀<gray>│ <red>Disabled" to player
            if {music} is true:
                send "<gray>│ <aqua>Music System⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀<gray>│ <lime>Enabled" to player
            else:
                send "<gray>│ <aqua>Music System⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀<gray>│ <red>Disabled" to player
            if {kms} is true:
                send "<gray>│ <aqua>KMS Command⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀<gray>│ <lime>Enabled" to player
            else:
                send "<gray>│ <aqua>KMS Command⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀<gray>│ <red>Disabled" to player
            if {afk} is true:
                send "<gray>│ <aqua>AFK System⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀<gray>│ <lime>Enabled" to player
            else:
                send "<gray>│ <aqua>AFK System⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀<gray>│ <red>Disabled" to player
            if {security} is true:
                send "<gray>│ <aqua>Security Mode⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀<gray>│ <red>Active" to player
            else:
                send "<gray>│ <aqua>Security Mode⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀<gray>│ <lime>Inactive" to player
            if {proxy} is true:
                send "<gray>│ <aqua>Proxy Transfers⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀<gray>│ <lime>Enabled" to player
            else:
                send "<gray>│ <aqua>Proxy Transfers⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀<gray>│ <red>Disabled" to player
            if {info} is true:
                send "<gray>│ <aqua>info Mode⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀<gray>│ <lime>Enabled" to player
            else:
                send "<gray>│ <aqua>info Mode⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀<gray>│ <red>Disabled" to player
            send "<gray>▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬" to player
            send "<gray>Pages: <yellow>1<gray>, <yellow>2<gray>, <yellow>3<gray>, <yellow>4" to player

        else:
            send "{@prefix} <red>Unknown help page." to player
            send "<gray>Use <yellow>/EssentialsLite/help 1<gray>, <yellow>2<gray>, <yellow>3<gray>, or <yellow>4" to player

        send ""

command /playerdata <offline player>:
    usage: &7▬▬▬▬▬▬▬▬▬ &6Arguments &7▬▬▬▬▬▬▬▬%nl%<light blue>/playerdata <yellow><player> <dark grey>-<reset> View player info%nl%&7▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬
    trigger:

        send "<gray>▬▬▬▬▬▬▬▬▬▬ <orange><bold>PlayerData <gray>▬▬▬▬▬▬▬▬▬▬" 
        send ""

        send "<orange>Player: <underline><lime>%arg-1%" 
        send "<orange>UUID: <underline><lime>%uuid of arg-1%"
        if arg-1 is online:
            send "<orange>IP: <underline><lime>%ip of arg-1%" 
        else:
            send "<orange>IP: <underline><red>OFFLINE" 
        if arg-1 is banned:
            send "<orange>Status: <underline><red>BANNED" 
        else if arg-1 is online:
            send "<orange>Status: <underline><lime>ONLINE" 
            send "<orange>World: <underline><lime>%world of arg-1%" 
            send "<orange>Ping: <underline><lime>%ping of arg-1%ms" 
            send "<orange>Location: <underline><lime>X(%x-coordinate of arg-1%) Y(%y-coordinate of arg-1%) Z(%z-coordinate of arg-1%)" 
        else:
            send "<orange>Status: <underline><red>OFFLINE" 

        send "" 
        send "<gray>▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬" 
#=====================================================================================
# PLAYER COMMANDS
#=====================================================================================

# Home
command /sethome <text>:
    executable by: players
    usage: &7▬▬▬▬▬▬▬▬▬ &6Arguments &7▬▬▬▬▬▬▬▬%nl%<light blue>/sethome <yellow><name> <dark grey>-<reset> Set a new home%nl%&7▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬
    trigger:
        set {_result} to setHome(player, arg-1, location of player)
        if {_result} is "error_1":
            send "{@prefix} <orange>This feature was disabled by the admin."
        else if {_result} is "success":
            takeMoney("nodebt", player, {_cost})
            send "{@prefix} <lime>Home named <gray>'<orange>%arg-1%<gray>'<lime> was set at X(%player's x-coordinate%), Y(%player's y-coordinate%), Z(%player's z-coordinate%). <lime>$<reset><yellow>%{_cost}% money deducted."

command /delhome <text>:
    executable by: players
    usage: &7▬▬▬▬▬▬▬▬▬ &6Arguments &7▬▬▬▬▬▬▬▬%nl%<light blue>/delhome <yellow><name> <dark grey>-<reset> Delete home%nl%&7▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬
    trigger:
        if arg-1 is "all":
            clear {home.homes::%uuid of player%::*}
            send "{@prefix} <orange>All homes were deleted."
            stop
        set {_result} to deleteHome(player, arg-1)
        if {_result} is "error_1":
            send "{@prefix} <orange>This feature was disabled by the admin."
        else if {_result} is "error_2":
            send "{@prefix} {@err_prefix} <red>Home named <gray>'<orange>%arg-1%<gray>'<red> was not found!"
        else if {_result} is "success":
            send "{@prefix} <orange>Home named <gray>'<orange>%arg-1%<gray>'<orange> was <red>deleted."

command /home <text>:
    executable by: players
    usage: &7▬▬▬▬▬▬▬▬▬ &6Arguments &7▬▬▬▬▬▬▬▬%nl%<light blue>/home <yellow><name> <dark grey>-<reset> Teleport to selected home%nl%&7▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬
    trigger:
        if {home.homes::%uuid of player%::%arg-1%} is not set:
            send "{@prefix} {@err_prefix} <red>Home named <gray>'<orange>%arg-1%<gray>'<red> was not found!"
            stop
            
        set {teleporting::%player%} to true
        set {teleport.start_loc::%player%} to location of player
        
        # Countdown 3
        playTitle("<lime>3", "<orange>Teleporting to home <gray>'<orange>%arg-1%<gray>'", player, 0.5 seconds, 0.25 seconds, 0.25 seconds)
        play sound "block.note_block.pling" to player
        wait 1 second
        if {teleporting::%player%} is not set:
            stop
            
        # Countdown 2
        playTitle("<orange>2", "<orange>Teleporting to home <gray>'<orange>%arg-1%<gray>'", player, 0.5 seconds, 0.25 seconds, 0.25 seconds)
        play sound "block.note_block.pling" to player
        wait 1 second
        if {teleporting::%player%} is not set:
            stop
            
        # Countdown 1
        playTitle("<red>1", "<orange>Teleporting to home <gray>'<orange>%arg-1%<gray>'", player, 0.5 seconds, 0.25 seconds, 0.25 seconds)
        play sound "block.note_block.pling" to player
        wait 1 second
        if {teleporting::%player%} is not set:
            stop
            
        # Teleport Execution
        clear {teleporting::%player%}
        clear {teleport.start_loc::%player%}
        playTitle("<light purple><=== <orange>%arg-1%<light purple> ===>", " ", player, 0.5 seconds, 0.25 seconds, 0.25 seconds)
        
        set {_result} to homeTeleport(player, arg-1)
        if {_result} is "error_1":
            send "{@prefix} <orange>This feature was disabled by the admin."
        else if {_result} is "error_2":
            send "{@prefix} {@err_prefix} <red>Home named <gray>'<orange>%arg-1%<gray>'<red> was not found!"
        else if {_result} is not set:
            send action bar "<lime>Teleported to home <gray>'<orange>%arg-1%<gray>'" to player

command /spawn:
    executable by: players
    usage: &7▬▬▬▬▬▬▬▬▬ &6Arguments &7▬▬▬▬▬▬▬▬%nl%<light blue>/spawn <dark grey>-<reset> Teleport to spawn location%nl%&7▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬
    trigger:
        if {spawn.location} is not set:
            send "{@prefix}<red> Sorry, but spawn is not set. Ask %{@owner_name}% to set it"
            stop
            
        set {teleporting::%player%} to true
        set {teleport.start_loc::%player%} to location of player
        
        # Countdown 3
        playTitle("<lime>3", "<orange>Teleporting to spawn", player, 0.5 seconds, 0.25 seconds, 0.25 seconds)
        play sound "block.note_block.pling" to player
        wait 1 second
        if {teleporting::%player%} is not set:
            stop
            
        # Countdown 2
        playTitle("<orange>2", "<orange>Teleporting to spawn", player, 0.5 seconds, 0.25 seconds, 0.25 seconds)
        play sound "block.note_block.pling" to player
        wait 1 second
        if {teleporting::%player%} is not set:
            stop
            
        # Countdown 1
        playTitle("<red>1", "<orange>Teleporting to spawn", player, 0.5 seconds, 0.25 seconds, 0.25 seconds)
        play sound "block.note_block.pling" to player
        wait 1 second
        if {teleporting::%player%} is not set:
            stop
            
        # Teleport Execution
        clear {teleporting::%player%}
        clear {teleport.start_loc::%player%}
        playTitle("<light purple><=== <orange>Spawn<light purple> ===>", " ", player, 0.5 seconds, 0.25 seconds, 0.25 seconds)
        teleport player to {spawn.location}

command /setwarp <text>:
    executable by: players
    usage: &7▬▬▬▬▬▬▬▬▬ &6Arguments &7▬▬▬▬▬▬▬▬%nl%<light blue>/setwarp <yellow><name> <dark grey>-<reset> Set a new warp%nl%&7▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬
    trigger:
        set {warp.warps::%arg-1%} to location of player
        subtract 500 from {money.count.%uuid of player%}
        send "{@prefix} <lime>Warp named <gray>'<orange>%arg-1%<gray>'<lime> was set at X(%player's x-coordinate%), Y(%player's y-coordinate%), Z(%player's z-coordinate%). <lime>$<reset><yellow>500 money deducted."

command /delwarp <text>:
    executable by: players
    usage: &7▬▬▬▬▬▬▬▬▬ &6Arguments &7▬▬▬▬▬▬▬▬%nl%<light blue>/delwarp <yellow><name> <dark grey>-<reset> Delete warp%nl%&7▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬
    trigger:
        if {warp.warps::%arg-1%} is set:
            clear {warp.warps::%arg-1%}
            send "{@prefix} <orange>Warp named <gray>'<orange>%arg-1%<gray>'<orange> was <red>deleted."
        else:
            send "{@prefix} {@err_prefix} <red>Warp named <gray>'<orange>%arg-1%<gray>'<red> was not found!"

command /warp <text>:
    executable by: players
    usage: &7▬▬▬▬▬▬▬▬▬ &6Arguments &7▬▬▬▬▬▬▬▬%nl%<light blue>/warp <yellow><name> <dark grey>-<reset> Teleport to selected warp%nl%&7▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬
    trigger:
        if {warp.warps::%arg-1%} is not set:
            send "{@prefix} {@err_prefix} <red>Warp named <gray>'<orange>%arg-1%<gray>'<red> was not found!"
            stop
            
        set {teleporting::%player%} to true
        set {teleport.start_loc::%player%} to location of player
        
        # Countdown 3
        playTitle("<lime>3", "<orange>Teleporting to warp <gray>'<orange>%arg-1%<gray>'", player, 0.5 seconds, 0.25 seconds, 0.25 seconds)
        play sound "block.note_block.pling" to player
        wait 1 second
        if {teleporting::%player%} is not set:
            stop
            
        # Countdown 2
        playTitle("<orange>2", "<orange>Teleporting to warp <gray>'<orange>%arg-1%<gray>'", player, 0.5 seconds, 0.25 seconds, 0.25 seconds)
        play sound "block.note_block.pling" to player
        wait 1 second
        if {teleporting::%player%} is not set:
            stop
            
        # Countdown 1
        playTitle("<red>1", "<orange>Teleporting to warp <gray>'<orange>%arg-1%<gray>'", player, 0.5 seconds, 0.25 seconds, 0.25 seconds)
        play sound "block.note_block.pling" to player
        wait 1 second
        if {teleporting::%player%} is not set:
            stop
            
        # Teleport Execution
        clear {teleporting::%player%}
        clear {teleport.start_loc::%player%}
        playTitle("<light purple><=== <orange>%arg-1%<light purple> ===>", " ", player, 0.5 seconds, 0.25 seconds, 0.25 seconds)
        teleport player to {warp.warps::%arg-1%}
        send action bar "<lime>Teleported to warp <gray>'<orange>%arg-1%<gray>'" to player

# kms
command /kms:
    executable by: players
    usage: &7▬▬▬▬▬▬▬▬▬ &6Arguments &7▬▬▬▬▬▬▬▬%nl%<light blue>/kms <dark grey>-<reset> Kill myself location%nl%&7▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬
    trigger:
        set {_result} to playerKMS(player)
        if {_result} is "error_1":
            send "{@prefix} <orange>This feature was disabled by the admin."

# Music
command /music <text>:
    usage: &7▬▬▬▬▬▬▬▬▬ &6Arguments &7▬▬▬▬▬▬▬▬%nl%<light blue>/music <yellow><text> <dark grey>-<reset> Play default minecraft music%nl%&7▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬
    trigger:
        set {_result} to playMusic(arg-1, player)
        if {_result} is "error_1":
            send "{@prefix} <orange>This feature was disabled by the admin."

#=====================================================================================
# HELPERS
#=====================================================================================

# AFK Command
command /afk:
    executable by: players
    usage: &7▬▬▬▬▬▬▬▬▬ &6Arguments &7▬▬▬▬▬▬▬▬%nl%<light blue>/afk <dark grey>-<reset> Toggle AFK%nl%&7▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬
    trigger:
        if {feature::afk} is true:
            if {afk::%player%} is set:
                delete {afk.on::%player%}
                set {afk.last::%player%} to now
                broadcast "{@prefix} <yellow>%player% is no longer AFK."
                teamClear(player)
            else:
                apply glowing 1 to player for 5 seconds
                set {afk.on::%player%} to true
                set {afk.last::%player%} to now
                broadcast "{@prefix} <yellow>%player% is now AFK."
                execute console command "team join AFK %player%"
        if {feature::afk} is false:
            send "{@prefix} <orange>This feature was disabled by the admin."

command /tpa <player>:
    usage: &7▬▬▬▬▬▬▬▬▬ &6Arguments &7▬▬▬▬▬▬▬▬%nl%<light blue>/tpa <yellow><player> <dark grey>-<reset> Teleport to player, when requested%nl%&7▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬
    trigger:
        if arg-1 is player:
            send "{@prefix} &cYou cannot teleport to yourself." to player
            stop
        if {tpa.cooldown.%player%} is set:
            send "{@prefix} &cPlease wait before sending another request." to player
            stop

        set {tpa.request.%arg-1%} to player
        set {tpa.cooldown.%player%} to true
        
        send "{@prefix} &aRequest sent to &e%arg-1%" to player
        send "{@prefix} &e%player% &awants to teleport to you." to arg-1
        send "{@prefix} &7Type &a/tpaprove &7or &c/tpadeny" to arg-1

        # Timeout Logic
        wait {@tpa-timeout} seconds
        if {tpa.request.%arg-1%} is player:
            delete {tpa.request.%arg-1%}
            send "{@prefix} &cTeleport request to %arg-1% expired." to player
        
        # Cooldown Logic
        wait {@tpa-cooldown} seconds
        delete {tpa.cooldown.%player%}

command /tpahere <player>:
    usage: &7▬▬▬▬▬▬▬▬▬ &6Arguments &7▬▬▬▬▬▬▬▬%nl%<light blue>/tpahere <yellow><player> <dark grey>-<reset> Request teleport to player%nl%&7▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬
    trigger:
        if arg-1 is not set:
            send "{@prefix} &cUsage: /tpahere <player>" to player
            stop
        if arg-1 is player:
            send "{@prefix} &cYou cannot teleport yourself." to player
            stop
        if {tpa.cooldown.%player%} is set:
            send "{@prefix} &cPlease wait before sending another request." to player
            stop

        set {tpahere.request.%arg-1%} to player
        set {tpa.cooldown.%player%} to true

        send "{@prefix} &aTeleport-here request sent to &e%arg-1%" to player
        send "{@prefix} &e%player% &awants you to teleport to them." to arg-1
        send "{@prefix} &7Type &a/tpaprove &7or &c/tpadeny" to arg-1

        wait {@tpa-timeout} seconds
        if {tpahere.request.%arg-1%} is player:
            delete {tpahere.request.%arg-1%}
            send "{@prefix} &cTeleport-here request from %player% expired." to arg-1

        wait {@tpa-cooldown} seconds
        delete {tpa.cooldown.%player%}

command /tpaprove:
    usage: &7▬▬▬▬▬▬▬▬▬ &6Arguments &7▬▬▬▬▬▬▬▬%nl%<light blue>/tpapprove(/tpaccept)<dark grey>-<reset> Approve latest TPA request%nl%&7▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬
    aliases: /tpaccept
    trigger:
        if {tpa.request.%player%} is set:
            set {_requester} to {tpa.request.%player%}
            teleport {_requester} to player
            send "{@prefix} &aTeleporting &e%{_requester}% &ato you." to player
            send "{@prefix} &e%player% &aaccepted. Teleporting..." to {_requester}
            delete {tpa.request.%player%}
            stop
            
        if {tpahere.request.%player%} is set:
            set {_target} to {tpahere.request.%player%}
            teleport player to {_target}
            send "{@prefix} &aTeleporting you to &e%{_target}%&a." to player
            send "{@prefix} &e%player% &aaccepted your request." to {_target}
            delete {tpahere.request.%player%}
            stop

        send "{@prefix} &cNo pending requests found."

command /tpadeny:
    usage: &7▬▬▬▬▬▬▬▬▬ &6Arguments &7▬▬▬▬▬▬▬▬%nl%<light blue>/tpapprove <dark grey>-<reset> Deny latest TPA request%nl%&7▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬
    trigger:
        if {tpa.request.%player%} is set:
            send "{@prefix} &cRequest denied." to player
            send "{@prefix} &e%player% &cdenied your request." to {tpa.request.%player%}
            delete {tpa.request.%player%}
            stop
        if {tpahere.request.%player%} is set:
            send "{@prefix} &cRequest denied." to player
            send "{@prefix} &e%player% &cdenied your request." to {tpahere.request.%player%}
            delete {tpahere.request.%player%}
            stop
        send "{@prefix} &cNo pending requests found."


#=====================================================================================
#   TRIGGERS
#=====================================================================================
on chat:
    if {afk.on::%player%} is set:
        delete {afk.on::%player%}
        set {afk.last::%player%} to now
        broadcast "<yellow>%player% is no longer AFK."
        execute console command "team leave AFK %player%"



on damage of player:
    set {_attacker} to attacker
    set {_victim} to victim
    
    if {afk.on::%{_victim}%} is set:
        cancel event
        send "<red><bold>That player is currently AFK!" to {_attacker}
        stop
    
    if {security} is true:
        if {_victim} is not op:
            cancel event

on join:
    set join message to {@player_join}
    set {join.time::%player's uuid%} to now
    add 1 to {join.times}
    
    if {ip.check} is true:
        set {_result} to validatePlayerIP(player)
        if {_result} is "warning_1":
            send "{@prefix} {@warn_prefix} <orange>Your IP has been registered. If your IP changes, you may get banned. If you did, ask admin to clear the database."
        else if {_result} is "error_1":
            kick player due to "<orange>AUTOKICKED%nl%<light gray>You were autokicked by server's IP enforcement.%nl%If you think that this is an error, ask admin to clear your IP adress."

    if {lobby.is_lobby} is true:
        teleport player to {spawn.location}
    if {player.changelog.%player%} is not set:
        set {player.changelog.%player%} to 0

    if {player.changelog.%player%} is not {@changelog-version}:
        wait 2 seconds
        sendChangelog(player)
        set {player.changelog.%player%} to {@changelog-version}
    wait 5 ticks
    
    
on quit:
    delete {join.time::%player's uuid%}
    set leave message to {@player_leave}
    teamClear(player)
    execute console command "team leave %player%"
    if {autoban} is true:
        set {_time_online} to difference between {join.time::%player's uuid%} and now
        if {_time_online} is less than {@autoban_treshhold}:
            set {_bantime} to {@ban_time}
            execute console command "/ban %player% Suspicious activity detected. %{_bantime}%"
        delete {join.time::%player's uuid%}

on player move:
    if {home.cancel_if_move::%player%} is true:
        set {home.has_moved::%player%} to true
        clear {home.cancel_if_move::%player%}
        stop
    if {jail.jailed::%uuid of player%} is true:
        teleport player to {jail.location}
        
    if {afk.on::%player%} is set:
        if distance between event-location and past event-location > {@afk_disable_trigger}:
            delete {afk.on::%player%}
            set {afk.last::%player%} to now
            broadcast "{@prefix} <yellow>%player% is no longer AFK."
            send "{@prefix} {@info_prefix} <aqua>Toggling AFK status for %{player}%" to console
            teamClear(player)
            apply glowing 1 to player for 1 second
    else:
        stop

on death of player:
    if {kms.death.%uuid of victim%} is true:
        set death message to "%victim% killed himself"
        delete {kms.death.%uuid of victim%}
on block break:
    if {jailed::%uuid of player%} is true:
        cancel event
on any move:
    if {teleporting::%player%} is true:
        # Check if the player actually changed blocks, not just rotated their head
        if x-coordinate of event-location is not x-coordinate of {teleport.start_loc::%player%}:
            set {_moved} to true
        else if y-coordinate of event-location is not y-coordinate of {teleport.start_loc::%player%}:
            set {_moved} to true
        else if z-coordinate of event-location is not z-coordinate of {teleport.start_loc::%player%}:
            set {_moved} to true
            
        if {_moved} is true:
            clear {teleporting::%player%}
            clear {teleport.start_loc::%player%}
            playTitle("<red>Teleport Cancelled", "<orange>You moved!", player, 0.5 seconds, 0.25 seconds, 0.25 seconds)
            play sound "block.note_block.didgeridoo" to player

on quit:
    clear {teleporting::%player%}
    clear {teleport.start_loc::%player%}
#=====================================================================================
# SPARKLITE
#=====================================================================================
every 5 seconds:

    set {_tps} to tps from last 1 minute
    loop all players:

        if loop-player's ping > {@ping_warn_treshold}:
            send "{@sparklite_prefix} <orange>Your connection is unstable!" to loop-player
        if loop-player's ping > {@ping_kick_treshold}:
            broadcast "{@sparklite_prefix} <orange>Kicking player %loop-player% due to too high ping levels"
            wait 1 second
            kick loop-player due to "<red>Too high ping level" 

        if tps from last 1 minute is less than {@tps_warn_treshold}:
            send "{@sparklite_prefix} <orange>Low TPS detected. ( %{_tps}% / 20 )" to console

        if tps from last 1 minute is less than {@tps_restart_treshold}:
            loop 10 times:
                wait 0.1 seconds
            wait 1 seconds
            execute console command "tick rate 20"
            wait 1 second
            kick loop-player due to "<orange>Too low TPS. Restarting."
            restart server



#=====================================================================================
# TAB COMPLETIONS
#=====================================================================================

# /feature <enable/disable> <feature>
on tab complete of "/feature":
    set tab completions for position 1 to "enable" and "disable"
    set tab completions for position 2 to "music", "home", "kms", "afk" and "all"
on tab complete of "/kill":
    set tab completions for position 1 to "@p", "all", "@e", "@m" and all players

# /music <disc>
on tab complete of "/music":
    set tab completions for position 1 to "stop", "list", "13", "cat", "blocks", "chirp", "far", "mall", "mellohi", "stal", "strad", "ward", "11", "wait", "otherside", "pigstep", "5", "relic", "precipice", "creator", "creator_music_box", "lava_chicken" and "tears"

# /EssentialsLite/help <page>
on tab complete of "/EssentialsLite/help":
    set tab completions for position 1 to "1", "2", "3" and "4"

# /ping <player>
on tab complete of "/ping":
    set tab completions for position 1 to all players

# /home & /delhome (List unique player homes)
on tab complete of "/home" or "/delhome":
    set {_homes::*} to indices of {home.homes::%uuid of player%::*}
    set tab completions for position 1 to {_homes::*}
on tab complete of "/warp" or "/delwarp":
    set {_warps::*} to indices of {warp.warps::%player%::*}
    set tab completions for position 1 to {_warps::*}
# /ban → suggest online players
on tab complete of "/ban":
    set tab completions for position 1 to all players
    set tab completions for position 2 to "spamming", "cheating", "breaking rules", "no reason specified" and "server overloading"
    set tab completions for position 3 to "30 seconds", "1 minute", "15 minutes", "30 minutes", "1 hour", "6 hours", "12 hours", "1 day", "4 days", "1 week", "2 weeks", "1 month", "6 months" and "1 year"
# /unban → suggest banned players
on tab complete of "/invesee":
    set tab completions for position 1 to all players
on tab complete of "/unban":
    set {_banned::*} to offline players
    set tab completions for position 1 to {_banned::*}
on tab complete of "/stop":
    set tab completions for position 1 to "broadcast:backup" and "broadcast:false"
on tab complete of "/restart":
    set tab completions for position 1 to "broadcast:false"
on tab complete of "/ip":
    set tab completions for position 1 to "clear"
    set tab completions for position 2 to all players

